{
	"name": "vitepress-plugin-outline-depth",
	"version": "1.1.1",
	"description": "VitePress plugin that controls the heading level depth of the sidebar (outline / table of contents)",
	"homepage": "https://github.com/otomad/vitepress-plugin-outline-depth#readme",
	"bugs": {
		"url": "https://github.com/otomad/vitepress-plugin-outline-depth/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/otomad/vitepress-plugin-outline-depth.git"
	},
	"license": "MIT",
	"author": "lunate",
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"import": "./dist/components/index.js"
		}
	},
	"scripts": {
		"test": "vitest",
		"clear": "rimraf dist",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"fmt:dist": "oxfmt dist/",
		"build": "pnpm run clear && pnpm run /^build:.*/ && pnpm run fmt:dist",
		"build:tsc": "tsc --noCheck",
		"build:component": "mkdist --pattern **/*.vue --declaration --no-clean",
		"watch": "pnpm run clear && pnpm run /^watch:.*/",
		"watch:tsc": "tsc --watch --noCheck",
		"watch:component": "cpx \"src/components/**/*.vue\" dist/components --watch",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"files": [
		"dist"
	],
	"devDependencies": {
		"@chromatic-com/storybook": "latest",
		"@storybook/addon-a11y": "^10.5.7",
		"@storybook/addon-docs": "^10.5.7",
		"@storybook/addon-onboarding": "^10.5.7",
		"@storybook/vue3-vite": "^10.5.7",
		"@types/node": "^26.1.2",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vitest/browser-playwright": "latest",
		"@vitest/coverage-v8": "latest",
		"cpx2": "^9.0.0",
		"mkdist": "^2.4.1",
		"oxfmt": "^0.61.0",
		"playwright": "latest",
		"rimraf": "^6.1.3",
		"storybook": "^10.5.7",
		"storybook-dark-mode": "^5.0.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vitepress": "^1.6.4",
		"vue": "^3.5.41",
		"vue-sfc-transformer": "^0.2.5",
		"vue-tsc": "^3.3.9"
	},
	"keywords": [
		"vitepress",
		"vitepress-plugin",
		"outline-depth",
		"outline-depth-toggle",
		"outline",
		"depth",
		"auto-expand"
	],
	"dependencies": {
		"smooth-value": "^1.1.0"
	}
}
