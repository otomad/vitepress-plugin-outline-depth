{
	"name": "vitepress-plugin-outline-depth",
	"version": "1.0.0",
	"description": "",
	"homepage": "https://github.com/otomad/vitepress-plugin-outline-depth#readme",
	"bugs": {
		"url": "https://github.com/otomad/vitepress-plugin-outline-depth/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/otomad/vitepress-plugin-outline-depth.git"
	},
	"license": "MIT",
	"author": "lunate",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"test": "vitest",
		"build": "vite build -c vite.config.build.ts",
		"dev": "pnpm run /^dev:.*/",
		"dev:plugin": "npx tsup src/index.ts --dts --watch --format esm,cjs --external vitepress",
		"dev:component": "tsc --sourcemap -w --preserveWatchOutput -p src/components",
		"build:tsup": "pnpm run /^build:.*/",
		"build:plugin": "npx tsup src/index.ts --dts --format esm,cjs --external vitepress --silent",
		"build:component": "tsc -p src/components && node scripts/copyComponents.mjs"
	},
	"files": [
		"dist"
	],
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/language-core": "^3.3.8",
		"oxfmt": "^0.61.0",
		"rimraf": "^6.1.3",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vite-plugin-dts": "^5.0.3",
		"vitepress": "^1.6.4",
		"vue": "^3.5.40"
	},
	"keywords": [
		"vitepress",
		"vitepress-plugin",
		"outline-depth",
		"outline-depth-toggle",
		"outline",
		"depth",
		"auto-expand"
	]
}
